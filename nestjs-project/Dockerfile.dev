FROM node:25.6.0-trixie-slim

# The development image runs the media integration tests.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg=7:7.1.5-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y procps curl

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 