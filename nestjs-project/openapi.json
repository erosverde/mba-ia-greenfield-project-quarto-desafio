  "info": {
    "title": "StreamTube API",
    "description": "API REST do StreamTube",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {}
      },
      "ResendConfirmationDto": {
        "type": "object",
        "properties": {}
      },
      "LoginDto": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {}
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {}
      },
      "StartVideoUploadDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sizeBytes": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000000000
          }
        },
        "required": [
          "title",
          "sizeBytes"
        ]
      },
      "VideoUploadSessionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ]
          },
          "partSizeBytes": {
            "type": "number"
          },
          "partCount": {
            "type": "number"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "partSizeBytes",
          "partCount",
          "expiresAt"
        ]
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Invalid email or password"
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "VideoUploadPartDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "contentLength": {
            "type": "number"
          },
          "validForSeconds": {
            "type": "number"
          }
        },
        "required": [
          "url",
          "contentLength",
          "validForSeconds"
        ]
      },
      "VideoUploadStateDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ]
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "VideoStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PROCESSING",
              "READY",
              "ERROR"
            ]
          },
          "title": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "durationMs": {
            "type": "number",
            "nullable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "streamUrl": {
            "type": "string",
            "nullable": true
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true
          },
          "downloadUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "title",
          "sizeBytes",
          "durationMs",
          "metadata",
          "errorCode",
          "streamUrl",
          "thumbnailUrl",
          "downloadUrl"
        ]
      }
    }
  }
}