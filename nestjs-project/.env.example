# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM='StreamTube <noreply@streamtube.com>'

# Videos
VIDEO_STORAGE_ENDPOINT=http://minio:9000
VIDEO_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
VIDEO_STORAGE_BUCKET=streamtube-videos
VIDEO_STORAGE_REGION=us-east-1
VIDEO_STORAGE_ACCESS_KEY=streamtube-dev
VIDEO_STORAGE_SECRET_KEY=streamtube-dev-secret
VIDEO_STORAGE_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
